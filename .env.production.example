APP_NAME=Laras
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://laras.example.com
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=db_laras
DB_USERNAME=laras
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

LARAS_DEFAULT_LOCALE=id
LARAS_DEFAULT_CURRENCY=IDR
LARAS_DEFAULT_TIMEZONE=Asia/Jakarta
LARAS_DEFAULT_DATE_FORMAT="d/m/Y"
LARAS_DEFAULT_TIME_FORMAT="H:i"
LARAS_WEEK_STARTS_ON=1

LARAS_ELOQUENT_STRICT=false
LARAS_QUERY_MONITORING=true
LARAS_QUERY_RESPONSE_HEADERS=false
LARAS_SLOW_QUERY_THRESHOLD_MS=250
LARAS_CUMULATIVE_QUERY_THRESHOLD_MS=500
LARAS_QUERY_SQL_PREVIEW_LENGTH=1000
